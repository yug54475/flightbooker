# Server
PORT=8000

# Database (matches docker-compose.yml — port 5433 mapped to container's 5432)
DATABASE_URL=postgres://flightbooker:flightbooker@127.0.0.1:5433/flightbooker?sslmode=disable

# JWT
JWT_SECRET=hackathon-dev-secret-do-not-use-in-prod

# AWS / LocalStack (SQS)
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_NAME=disruption-events

# AI Agent Service
AGENT_SERVICE_URL=http://localhost:8001

# Redis
REDIS_URL=localhost:6379

# CORS
CORS_ALLOWED_ORIGIN=http://localhost:5173
